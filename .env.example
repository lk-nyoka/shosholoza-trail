
# ── Backend (optional) ───────────────────────────────────────────────────────
# Leave both blank and the app runs exactly as it always has: everything on the
# device, nothing sent anywhere. Fill them in and trips, reservations and the
# interest list are mirrored to Supabase.
#
# The anon key is a PUBLIC key. It is safe in the bundle because Row Level
# Security decides what it can see. The service_role key is NOT safe anywhere
# in this repository - it bypasses RLS entirely. Never put it here.
VITE_SUPABASE_URL=
# Preferred for current Supabase projects:
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use this instead; the client accepts either key name:
VITE_SUPABASE_ANON_KEY=
