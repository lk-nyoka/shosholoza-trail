SHOSHOLOZA_ENV=development
SHOSHOLOZA_DATABASE_URL=sqlite:///./data/shosholoza.db
SHOSHOLOZA_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
SHOSHOLOZA_TRUSTED_HOSTS=localhost,127.0.0.1
SHOSHOLOZA_PING_RATE_LIMIT_SECONDS=10
SHOSHOLOZA_MAX_PING_ACCURACY_METRES=1000
SHOSHOLOZA_MAX_ROUTE_DISTANCE_KM=20
