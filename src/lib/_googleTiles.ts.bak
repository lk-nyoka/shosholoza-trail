import * as THREE from "three";
import type { LatLng } from "./geoTiles";

/**
 * Google Photorealistic 3D Tiles, loaded into the existing Three.js scene via
 * 3d-tiles-renderer rather than by switching the app to CesiumJS.
 *
 * Dormant until VITE_GOOGLE_MAPS_KEY is set in .env: with no key,
 * `createGoogleTiles` returns null and the Esri/terrarium streaming terrain
 * carries the whole route exactly as before.
 *
 * Coverage is the catch. Google's photorealistic mesh covers metros, so
 * Pretoria, Johannesburg and Cape Town look superb, while roughly 1,200 km of
 * this route - the Free State, the Karoo, the Hex River - has no mesh at all.
 * The streaming terrain therefore stays loaded underneath as the fallback.
 *
 * NOT YET RUN AGAINST A LIVE KEY. The anchoring maths below is the part most
 * likely to need a nudge; `heightOffset` is the first dial to reach for.
 *
 * TO ACTIVATE, after `npm install` (3d-tiles-renderer is already in
 * package.json), add these four things back to TrainMap.tsx at the marked
 * comment - they were removed only because Vite resolves imports at transform
 * time, so referencing this file before the package exists breaks the page:
 *
 *   1. import { GOOGLE_TILES_KEY, createGoogleTiles, hasGoogleCoverage,
 *              type GoogleTilesHandle } from "../../lib/googleTiles";
 *   2. let googleTiles: GoogleTilesHandle | null = null;
 *      if (GOOGLE_TILES_KEY) {
 *        void createGoogleTiles(renderer, camera).then(handle => {
 *          if (!handle) return;
 *          googleTiles = handle;
 *          handle.setOrigin(origin);
 *          scene.add(handle.group);
 *        });
 *      }
 *   3. in recentre(), after terrain.setOrigin(origin):
 *      googleTiles?.setOrigin(origin);
 *   4. in animate(), after previousPlaying = current.playing:
 *      if (googleTiles) {
 *        const covered = hasGoogleCoverage(current.km);
 *        googleTiles.group.visible = covered;
 *        terrain.group.visible = !covered;
 *        googleTiles.update();
 *      }
 *      and googleTiles?.dispose() in the cleanup.
 */

export const GOOGLE_TILES_KEY: string =
  (import.meta.env?.VITE_GOOGLE_MAPS_KEY as string | undefined)?.trim() ?? "";

/** Metros with photorealistic coverage, as route-km spans on this corridor. */
export const GOOGLE_COVERAGE_KM: [number, number][] = [
  [0, 90],       // Pretoria - Johannesburg
  [630, 665],    // Kimberley
  [1540, 1582],  // Cape Town
];

export const hasGoogleCoverage = (km: number) =>
  GOOGLE_COVERAGE_KM.some(([from, to]) => km >= from && km <= to);

export interface GoogleTilesHandle {
  group: THREE.Group;
  /** Re-anchor the tileset after a floating-origin shift. */
  setOrigin(origin: LatLng, heightOffset?: number): void;
  update(): void;
  attributions(): string;
  dispose(): void;
}

export async function createGoogleTiles(
  renderer: THREE.WebGLRenderer,
  camera: THREE.PerspectiveCamera,
  apiKey: string = GOOGLE_TILES_KEY,
): Promise<GoogleTilesHandle | null> {
  if (!apiKey) return null;
  try {
    const core = await import("3d-tiles-renderer");
    const plugins = await import("3d-tiles-renderer/plugins");
    const tiles = new core.TilesRenderer();
    tiles.registerPlugin(
      new plugins.GoogleCloudAuthPlugin({ apiToken: apiKey, autoRefreshToken: true }),
    );
    tiles.setCamera(camera);
    tiles.setResolutionFromRenderer(camera, renderer);

    const group = new THREE.Group();
    group.add(tiles.group);

    /**
     * Tile content is ECEF. Our scene is a local metric frame: +x east, +y up,
     * -z north. An east-north-up frame at the origin, composed with a +90 deg
     * X rotation that maps local (x, y, z) to ENU (x, -z, y), is the transform
     * from local to ECEF - so its inverse is what the group must carry.
     */
    const localToEnu = new THREE.Matrix4().makeRotationX(Math.PI / 2);
    const frame = new THREE.Matrix4();

    const setOrigin = (origin: LatLng, heightOffset = 0) => {
      tiles.ellipsoid.getEastNorthUpFrame(
        THREE.MathUtils.degToRad(origin[0]),
        THREE.MathUtils.degToRad(origin[1]),
        heightOffset,
        frame,
      );
      tiles.group.matrixAutoUpdate = false;
      tiles.group.matrix.copy(frame).multiply(localToEnu).invert();
      tiles.group.matrix.decompose(
        tiles.group.position,
        tiles.group.quaternion,
        tiles.group.scale,
      );
      tiles.group.updateMatrixWorld(true);
    };

    return {
      group,
      setOrigin,
      update: () => tiles.update(),
      // Google's terms require these to be shown wherever the tiles are.
      attributions: () => {
        try {
          return tiles.getAttributions().map((entry: { value: string }) => entry.value).join(" · ");
        } catch {
          return "Google";
        }
      },
      dispose: () => tiles.dispose(),
    };
  } catch (error) {
    console.warn("[ShosholozaTrail] Google 3D Tiles unavailable, staying on streaming terrain", error);
    return null;
  }
}
