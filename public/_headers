# Served by Netlify. Three jobs here: let fingerprinted files cache forever,
# give the manifest and the text files their real content types, and set the
# headers a security scan looks for.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # This app needs none of these, so it asks for none of them. Location is
  # requested at runtime with the passenger's permission, not by policy here.
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(), usb=(), interest-cohort=()
  X-Frame-Options: DENY

# Vite fingerprints these, so the name changes whenever the bytes do.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/basis/*
  Cache-Control: public, max-age=31536000, immutable

# The shell must never be cached, or a deploy never reaches anyone.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=3600

/robots.txt
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Content-Type: application/xml; charset=utf-8

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# ── Content Security Policy, enforced ───────────────────────────────────────
# Enforcing a wrong CSP kills the satellite imagery, the elevation tiles and
# every photograph, silently, with no console error the passenger will ever
# see. That is why this ran report-only, with a note to watch the reports for
# a week - which is not a plan anyone was going to carry out.
#
# It is enforced now because it is CHECKED instead of watched.
# `node scripts/check-csp.mjs` derives every origin the app actually contacts
# from the source, asserts the policy covers each one under the right
# directive, and then loads the built app in a real browser and fails on any
# violation the browser itself reports. That check found three gaps this
# policy had while it sat in report-only:
#
#   services.arcgisonline.com  the imagery-capture-date lookup
#   api.openstreetmap.org      the rail-geometry fetch
#   www.youtube-nocookie.com   the two Shosholoza recordings, which have no
#                              frame-src at all and would have been blocked
#                              outright the moment this was enforced
#   s3.amazonaws.com in img-src  the elevation tiles, which are decoded as
#                              IMAGES and not fetched - so connect-src alone
#                              was not enough and the terrain would have gone
#                              flat on every device. Reading the policy did
#                              not catch that one; the browser did.
#
# blob: is not optional - the vector-tile worker and Three.js both need it.
# frame-ancestors stays 'none' (nobody may embed us); frame-src names the one
# origin we embed.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https://server.arcgisonline.com https://*.wikimedia.org https://tiles.openfreemap.org https://s3.amazonaws.com; connect-src 'self' https://server.arcgisonline.com https://services.arcgisonline.com https://s3.amazonaws.com https://tiles.openfreemap.org https://api.openstreetmap.org https://*.wikimedia.org https://*.supabase.co wss://*.supabase.co; frame-src https://www.youtube-nocookie.com; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; worker-src 'self' blob:; manifest-src 'self'
