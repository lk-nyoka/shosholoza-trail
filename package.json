{
  "name": "shosholoza-trail-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "test": "node scripts/run-tests.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:layout:quick": "node scripts/check-layout.mjs --quick",
    "check:csp": "node scripts/check-csp.mjs",
    "verify": "tsc -b && node scripts/run-tests.mjs && vite build && node scripts/check-csp.mjs && node scripts/check-a11y.mjs && node scripts/check-layout.mjs",
    "check:a11y": "node scripts/check-a11y.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@vitejs/plugin-react": "^5.1.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "three": "^0.186.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "axe-core": "^4.13.0"
  }
}
