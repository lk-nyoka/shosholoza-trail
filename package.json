{
  "name": "shosholoza-trail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "vite build && node scripts/build-assets.mjs && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.js",
    "security:scan": "node scripts/scan-secrets.mjs",
    "test:browser": "playwright test",
    "harness:r3": "node harness/run-traces.js",
    "harness:ai": "node harness/ai-eval.js",
    "build:app": "vite build",
    "dev:app": "vite",
    "check:app": "tsc --noEmit -p app/tsconfig.json",
    "photos:fetch": "node scripts/fetch-photos.mjs",
    "photos:build": "node scripts/build-photos.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/suncalc": "^1.9.2",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "wrangler": "^4.129.1"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "@turf/turf": "^7.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.540.0",
    "maplibre-gl": "^6.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "suncalc": "1.9.0",
    "three": "^0.185.1"
  }
}
